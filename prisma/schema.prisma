datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model CommunityMember {
  id                   String           @id @default(cuid())
  fullName             String
  age                  Int              @default(30)
  email                String           @unique
  passwordHash         String
  occupationOrInterest String
  neighborhood         String           // e.g. "Koregaon Park", "Indiranagar", "Bandra West"
  city                 String           // e.g. "Pune, MH", "Bengaluru, KA"
  modePreference       String           @default("HYBRID") // ONLINE, IN_PERSON, HYBRID
  spokenLanguages      String           // Comma-separated or JSON
  bio                  String
  avatarUrl            String
  skillPointsBalance   Int              @default(50)
  averageRating        Float            @default(5.0)
  totalSessions        Int              @default(0)
  role                 String           @default("MEMBER") // MEMBER, ADMIN, MODERATOR
  createdAt            DateTime         @default(now())

  skills               MemberSkill[]
  sentRequests         ExchangeRequest[] @relation("SentRequests")
  receivedRequests     ExchangeRequest[] @relation("ReceivedRequests")
  reviewsGiven         Review[]          @relation("ReviewsGiven")
  reviewsReceived      Review[]          @relation("ReviewsReceived")
  questions            CommunityQuestion[]
  replies              QuestionReply[]
  pointTransactions    PointTransaction[]
}

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  pillar      String      // TECH_PROFESSIONAL, HEALTH_WELLNESS, CREATIVE_PRACTICAL, ACADEMIC_LANGUAGES
  category    String      // Gardening, Cooking, Yoga, Excel, Guitar, etc.
  iconName    String      @default("Sparkles")
  isApproved  Boolean     @default(true)

  memberSkills MemberSkill[]
}

model MemberSkill {
  id               String          @id @default(cuid())
  memberId         String
  skillId          String
  type             String          // TEACHING, LEARNING
  proficiency      String          // BEGINNER, INTERMEDIATE, EXPERIENCED
  yearsExperience  Int             @default(1)
  portfolioNote    String?

  member           CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill            Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model ExchangeRequest {
  id               String          @id @default(cuid())
  senderId         String
  receiverId       String
  offeredSkill     String
  requestedSkill   String
  status           String          @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED
  proposedTime     DateTime
  message          String
  createdAt        DateTime        @default(now())

  sender           CommunityMember @relation("SentRequests", fields: [senderId], references: [id])
  receiver         CommunityMember @relation("ReceivedRequests", fields: [receiverId], references: [id])
  session          Session?
}

model Session {
  id                String          @id @default(cuid())
  exchangeRequestId String          @unique
  meetingRoomId     String          @unique
  startTime         DateTime
  durationMinutes   Int             @default(60)
  status            String          @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  notesMarkdown     String?

  exchangeRequest   ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  reviews           Review[]
}

model Review {
  id          String          @id @default(cuid())
  sessionId   String
  reviewerId  String
  revieweeId  String
  ratingStars Int             // 1-5
  feedback    String
  tags        String          // "Patient Mentor,Practical Tips"
  createdAt   DateTime        @default(now())

  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer    CommunityMember @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee    CommunityMember @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}

model CommunityQuestion {
  id          String          @id @default(cuid())
  authorId    String
  title       String
  content     String
  pillar      String
  tags        String          // "Gardening,Compost,Organic"
  isSolved    Boolean         @default(false)
  upvotes     Int             @default(0)
  createdAt   DateTime        @default(now())

  author      CommunityMember @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies     QuestionReply[]
}

model QuestionReply {
  id               String            @id @default(cuid())
  questionId       String
  authorId         String
  content          String
  isSolution       Boolean           @default(false)
  upvotes          Int               @default(0)
  createdAt        DateTime          @default(now())

  question         CommunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author           CommunityMember   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PointTransaction {
  id        String          @id @default(cuid())
  memberId  String
  amount    Int
  reason    String
  createdAt DateTime        @default(now())

  member    CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
